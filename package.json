{
  "name": "dumbeditor",
  "version": "0.1.0",
  "description": "A direct, agent-first video editor that lives entirely in your terminal.",
  "type": "module",
  "bin": {
    "dumbeditor": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills",
    "assets",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/tests/time.test.js .test-dist/tests/preview.test.js .test-dist/tests/editor.test.js .test-dist/tests/advanced-editor.test.js .test-dist/tests/export.test.js .test-dist/tests/commands.test.js .test-dist/tests/music.test.js .test-dist/tests/model-picker.test.js .test-dist/tests/projects.test.js .test-dist/tests/keys.test.js .test-dist/tests/pi-layer.test.js .test-dist/tests/compaction.test.js .test-dist/tests/editor-state.test.js .test-dist/tests/actions.test.js .test-dist/tests/session-store.test.js .test-dist/tests/engine.test.js .test-dist/tests/live-openrouter.test.js .test-dist/tests/shell-layout.test.js .test-dist/tests/shell-state.test.js .test-dist/tests/shell-keymap.test.js .test-dist/tests/shell-preview.test.js .test-dist/tests/stream-preview.test.js .test-dist/tests/shell-views.test.js .test-dist/tests/shell-screen.test.js .test-dist/tests/shell-overlays.test.js .test-dist/tests/shell-panels.test.js .test-dist/tests/shell-app.test.js .test-dist/tests/transcription.test.js .test-dist/tests/windows-contract.test.js .test-dist/tests/painters.test.js .test-dist/tests/ffmpeg-capabilities.test.js .test-dist/tests/captions.test.js .test-dist/tests/text-image.test.js .test-dist/tests/doctor.test.js .test-dist/tests/packaging.test.js .test-dist/tests/kitty.test.js .test-dist/tests/probe.test.js .test-dist/tests/detect.test.js .test-dist/tests/blocks256.test.js .test-dist/tests/binaries.test.js .test-dist/tests/kitty-app.test.js",
    "quality": "npm run check && npm test && npm run build",
    "release:check": "npm run quality && npm pack --dry-run",
    "prepublishOnly": "npm run quality"
  },
  "keywords": [
    "video-editor",
    "cli",
    "ffmpeg",
    "terminal",
    "ai",
    "agent-first",
    "ai-native",
    "sixel",
    "open-source"
  ],
  "author": "Shreyash Kumar Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shing1Sks/DumbEditor.git"
  },
  "homepage": "https://github.com/shing1Sks/DumbEditor#readme",
  "bugs": {
    "url": "https://github.com/shing1Sks/DumbEditor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.77",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "dotenv": "^16.4.7",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.10.0",
    "@xterm/headless": "6.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "dumbeditor-canvas": "^0.1.0"
  }
}
