# Required for natural-language editing through GPT-6 Luna.
OPENAI_API_KEY=

# Optional now; reserved for image, audio, music, and video workflows.
OPENROUTER_API_KEY=

# Optional; enables Luna to delegate workspace coding tasks to Claude Agent SDK.
ANTHROPIC_API_KEY=

# Model defaults are managed by /model and stored in ~/.dumbeditor/settings.json.
